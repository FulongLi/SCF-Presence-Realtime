# Copy to .env.local and fill in. Everything here is read only by the server
# (src/app/api/realtime/token/route.ts, src/app/api/live/session/route.ts, src/app/page.tsx).
# No secret is sent to the browser.

# Required. Your standard OpenAI API key, used by BOTH voice backends. It never leaves the server:
# Realtime gives the browser a short-lived ephemeral client secret; GPT-Live sessions are created by
# the server, which returns only the SDP answer.
OPENAI_API_KEY=

# Optional. Voice backend: realtime (default, the stable baseline) | live (GPT-Live).
# For A/B testing, ?voice=realtime or ?voice=live overrides this per page load, and ?debug=1 has a switch.
SCF_VOICE_BACKEND=realtime

# ---- Realtime backend ----

# Optional. GA Realtime model. Default: gpt-realtime-2.1
OPENAI_REALTIME_MODEL=

# Optional. Output voice (e.g. marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse). Default: marin
OPENAI_REALTIME_VOICE=

# Optional. Turn detection: semantic_vad (default) or server_vad.
OPENAI_REALTIME_TURN_DETECTION=
# Optional. semantic_vad eagerness: low | medium | high | auto (default auto).
OPENAI_REALTIME_VAD_EAGERNESS=

# Optional. Set to a transcription model (e.g. gpt-4o-mini-transcribe) to receive user
# transcripts for ?debug=1 diagnostics. Empty = off (no extra transcription cost).
OPENAI_REALTIME_TRANSCRIPTION_MODEL=

# ---- GPT-Live backend (SCF_VOICE_BACKEND=live) ----

# Optional. GPT-Live voice model. Default: gpt-live-1
OPENAI_LIVE_MODEL=gpt-live-1

# Optional. Responses model GPT-Live delegates reasoning and visual tool selection to.
# Default: gpt-5.6-terra. gpt-5.6-luna is a lower-cost option.
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-terra

# Optional. GPT-Live output voice (e.g. marin, cedar, quartz, gleam, meridian, vesper). Default: marin
OPENAI_LIVE_VOICE=

# Optional. Backend reasoning effort: none | minimal | low | medium | high | xhigh (support depends on the
# backend model). Empty = the model's default. "low" usually shortens visual-tool latency.
OPENAI_LIVE_BACKEND_REASONING=

# ---- Shared ----

# Optional. Salt for hashing the anonymous installation id into OpenAI-Safety-Identifier.
# Set a random value in production so identifiers cannot be correlated across deployments.
SCF_SAFETY_ID_SALT=

# Optional. Comma-separated extra origins allowed to request tokens (the app's own origin
# is always allowed). Example: https://presence.example.com
SCF_ALLOWED_ORIGINS=

# Optional. Brave Search API key for web-scale image search (show_image / show_portrait fallback).
# Used only by the server route src/app/api/visual/image/route.ts; the browser never sees it.
# Empty = off: the open sources (Wikipedia, Wikimedia Commons, Openverse) still work without any key.
BRAVE_SEARCH_API_KEY=
